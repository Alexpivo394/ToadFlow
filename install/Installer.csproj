<Project Sdk="Microsoft.NET.Sdk">

    <!-- Сборщик MSI агента ToadFlow (WixSharp). Запускается из build-installer.ps1, в решение не входит. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RootNamespace>ToadFlow.Installer</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="WixSharp.Core"/>
        <PackageReference Include="WixSharp.Msi.Core"/>
    </ItemGroup>

</Project>
