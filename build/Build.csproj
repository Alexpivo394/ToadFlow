<Project Sdk="Microsoft.NET.Sdk">

    <!-- Сборка Windows-части: аддин для всех версий Revit, агент, тесты, установщик и релиз на GitHub (как в ToadTools).
         Запуск из build/: dotnet run -c Release, с аргументами test, pack, publish -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Sourcy.DotNet"/>
        <PackageReference Include="Shouldly"/>
        <PackageReference Include="ModularPipelines"/>
        <PackageReference Include="ModularPipelines.Git"/>
        <PackageReference Include="ModularPipelines.DotNet"/>
        <PackageReference Include="ModularPipelines.GitHub"/>
        <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
