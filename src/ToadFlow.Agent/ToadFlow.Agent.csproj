<Project Sdk="Microsoft.NET.Sdk">

    <!-- Агент ToadFlow на машине с Revit: иконка в трее, окно регистрации, автозапуск. Логика — в ToadFlow.Agent.Core. -->
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <RootNamespace>ToadFlow.Agent.App</RootNamespace>
        <AssemblyName>ToadFlow.Agent</AssemblyName>
        <!-- Версия разработческой сборки; выпуск задаёт свою через VersionPrefix (build/PublishAgentModule). Version здесь
             перекрыл бы её — так все агенты сообщали серверу 0.1.0. -->
        <VersionPrefix>0.1.0</VersionPrefix>
        <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Значок exe — его же показывают ярлык в «Пуске» и «Приложения» Windows -->
        <ApplicationIcon>Resources\toadflow.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\ToadFlow.Agent.Core\ToadFlow.Agent.Core.csproj"/>
    </ItemGroup>

    <!-- Тот же логотип для значка в трее и окна подключения -->
    <ItemGroup>
        <EmbeddedResource Include="Resources\toadflow.ico" LogicalName="toadflow.ico"/>
    </ItemGroup>

</Project>
