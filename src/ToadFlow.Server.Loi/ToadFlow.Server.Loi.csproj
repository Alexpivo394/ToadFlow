<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- Модуль «Проверка LOI» на сервере: профили ParamChecker, каталог категорий и параметров Revit, payload заданий -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Alexpivo394.Revit.ParamCheck.Profiles"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ToadFlow.Server\ToadFlow.Server.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ToadFlow.Server.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Числа BuiltInCategory из RevitAPI 2020–2024: по ним переводятся категории старых файлов ParamChecker -->
        <EmbeddedResource Include="BuiltInCategories.json" LogicalName="BuiltInCategories.json"/>
    </ItemGroup>

</Project>
