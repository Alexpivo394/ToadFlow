# Скопируйте в .env рядом с docker-compose.yml и заполните.

# Пароль базы данных
POSTGRES_PASSWORD=change_me

# Ключ подписи токенов входа — длинная случайная строка, не короче 32 символов: openssl rand -base64 48
JWT_KEY=change_me_to_a_long_random_secret_at_least_32_chars

# Первый администратор: создаётся при первом запуске, пока пользователей нет
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me

# Порт веб-интерфейса на хосте; агенты подключаются к этому же адресу
WEB_PORT=8080
