# Скопируйте в .env рядом с docker-compose.yml и заполните.

# Пароль базы данных
POSTGRES_PASSWORD=change_me

# Ключ подписи токенов входа — длинная случайная строка, не короче 32 символов: openssl rand -base64 48
JWT_KEY=change_me_to_a_long_random_secret_at_least_32_chars

# Общий ключ сервера и движка коллизий — не короче 32 символов: openssl rand -base64 48
CLASH_ENGINE_KEY=

# Первый администратор: создаётся при первом запуске, пока пользователей нет
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me

# Порт веб-интерфейса на хосте; агенты подключаются к этому же адресу
WEB_PORT=8080

# Движок коллизий: ядра и память контейнера. По умолчанию 2 ядра и 4 ГБ — для хоста с 4 ядрами и 8 ГБ.
# Большие части (сотни тысяч элементов) быстрее с 4–8 ядрами и 8 ГБ; ядер не больше, чем у хоста, иначе контейнер не запустится.
CLASH_ENGINE_CPUS=2
CLASH_ENGINE_MEMORY=4g

# Сервер: лимит памяти и сколько картинок коллизий рисуется одновременно
SERVER_MEMORY=3g
CLASH_IMAGE_THREADS=2
# Память под разобранные слепки для наборов, 3D и картинок, МБ; 0 — половина памяти сервера
CLASH_ELEMENTS_CACHE_MB=0
